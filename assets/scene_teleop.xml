<!--
  Teleop scene: the Booster K1 + two draggable target cubes.

  `setup-assets` copies this file INTO assets/booster_k1/, next to
  K1_22dof.xml. It must live there: MuJoCo resolves relative asset paths
  (K1_22dof.xml says meshdir="meshes/") against the directory of the MAIN
  xml file, so including the robot from any other directory breaks its mesh
  loading. (Lesson §2 shows the exact error you get otherwise.)

  Unlike most robot files, Booster's K1_22dof.xml already ships a complete
  mini-scene of its own — a ground plane (named "ground"), a skybox and two
  lights — so we add none of those here, only what teleop needs.

  The two mocap bodies are the heart of the whole project: a mocap body has
  no joints and no physics - its pose is whatever you write into
  data.mocap_pos / data.mocap_quat. Sources write it, the mouse can drag it,
  and the IK chases it. (The K1 tracks position only - its 4-DoF arms have no
  orientation budget - so the cubes are plain, with no orientation marker.)
-->
<mujoco model="k1_teleop">
  <include file="K1_22dof.xml"/>

  <statistic center="0 0 0.55" extent="1.1"/>
  <visual>
    <!-- offwidth/offheight: MuJoCo's OFFSCREEN framebuffer is 640x480 unless
         raised here; render-videos needs it for 720p/1080p frames. -->
    <global azimuth="140" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>

  <worldbody>
    <!-- Left-hand target (red). contype/conaffinity 0: collides with nothing. -->
    <body name="left_target" mocap="true" pos="0.2 0.2 0.6">
      <geom type="box" size="0.03 0.03 0.03" contype="0" conaffinity="0"
            rgba="0.90 0.25 0.20 0.5"/>
    </body>

    <!-- Right-hand target (green). -->
    <body name="right_target" mocap="true" pos="0.2 -0.2 0.6">
      <geom type="box" size="0.03 0.03 0.03" contype="0" conaffinity="0"
            rgba="0.20 0.70 0.30 0.5"/>
    </body>
  </worldbody>
</mujoco>
